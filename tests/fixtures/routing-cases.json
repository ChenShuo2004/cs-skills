      "expectedBehavior": [
        "直接交付完整文章，保留已给事实。"
      ],
      "forbiddenBehavior": [
        "要求先批准提纲或编造亲身经历。"
      ],
      "evidence": [
        {
          "path": "cs-writer/SKILL.md"
        }
      ]
    },
